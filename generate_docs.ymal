name: 📘 AI Selective Docs Generator (High Speed - Split Files)

on:
  push:
    branches: [ main, dev1 ]
  workflow_dispatch:

permissions:
  contents: write

jobs:
  generate-docs:
    runs-on: ubuntu-latest
    steps:
      - name: 📥 Checkout Code
        uses: actions/checkout@v4
        with:
          # Fetch all history so that rebase can find a common ancestor
          fetch-depth: 0

      - name: 💾 Persistent AI Cache
        uses: actions/cache@v4
        with:
          path: |
            ~/.ollama
            .ai_docs_tracker.txt
          key: ai-docs-split-v1
          restore-keys: |
            ai-docs-split-

      - name: 🦙 Fast Install Ollama
        run: |
          # Install Ollama CLI and run the server in the background
          curl -fsSL https://ollama.com/install.sh | sh
          ollama serve &
          # Wait until the Ollama API is responsive
          until curl -s localhost:11434 > /dev/null; do sleep 1; done
          # Pull the lightweight coder model
          ollama pull qwen2.5-coder:1.5b

      - name: 🐍 Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.10'

      - name: 📦 Install Requests
        run: pip install requests

      - name: 🤖 Run AI Documentation Crawler (Split Mode)
        run: |
          python << 'EOF'
          import os, requests, pathlib

          MODEL_NAME = "qwen2.5-coder:1.5b"
          TRACKER_FILE = ".ai_docs_tracker.txt"
          DOCS_BASE_DIR = "docs/ai"
          BATCH_LIMIT = 5 # Process 5 new files per run to save time

          TARGET_PATHS = ["app/Facades/", "app/Features/PatientSatisfaction/","app/Features/ClinicUsers"]

          # Load previously documented files to avoid redundant processing
          documented_files = set()
          if os.path.exists(TRACKER_FILE):
              with open(TRACKER_FILE, 'r', encoding='utf-8') as f:
                  documented_files = set(line.strip() for line in f)

          all_selected_files = []
          for target in TARGET_PATHS:
              if os.path.isdir(target):
                  for root, _, files in os.walk(target):
                      for f in files:
                          if f.endswith(".php"):
                              all_selected_files.append(os.path.join(root, f))
              elif os.path.isfile(target):
                  all_selected_files.append(target)

          processed_files = []

          for path in all_selected_files:
              if path not in documented_files:
                  print(f"🚀 Speed Processing: {path}")
                  try:
                      with open(path, 'r', encoding='utf-8') as f:
                          code_content = f.read()[:3000] # Analyze only the first 3k chars for speed

                      # Ask AI to generate a clean markdown table
                      payload = {
                          "model": MODEL_NAME,
                          "prompt": f"Create technical documentation for this PHP file. Include: 1. Purpose 2. Table of Functions. Format: Markdown. File Path: {path}\n\nCode:\n{code_content}",
                          "stream": False,
                          "options": {"num_predict": 600, "temperature": 0}
                      }

                      res = requests.post("http://localhost:11434/api/generate", json=payload, timeout=120)

                      if res.status_code == 200:
                          ai_response = res.json().get('response', '')
                          rel_path = os.path.normpath(path)
                          # Mirror the source directory structure inside docs/ai/
                          doc_file_path = os.path.join(DOCS_BASE_DIR, os.path.splitext(rel_path)[0] + ".md")
                          os.makedirs(os.path.dirname(doc_file_path), exist_ok=True)

                          with open(doc_file_path, 'w', encoding='utf-8') as f_doc:
                              f_doc.write(f"# 📄 Documentation: `{path}`\n\n")
                              f_doc.write(ai_response)
                              f_doc.write(f"\n\n---\n*Generated by AI on: 2026*")

                          processed_files.append(path)
                      if len(processed_files) >= BATCH_LIMIT: break
                  except Exception as e:
                      print(f"❌ Error processing {path}: {e}")

          # Update the tracker file with successfully processed paths
          if processed_files:
              with open(TRACKER_FILE, 'a', encoding='utf-8') as f:
                  for f_path in processed_files: f.write(f_path + "\n")
          EOF

      - name: 📤 Intelligent Push (Handles Conflicts)
        run: |
          # Configure Git Bot identity
          git config --global user.name 'AI Docs Bot'
          git config --global user.email 'ai-bot@bot.com'

          # Stage the new documentation and the tracker file
          git add docs/ai/ .ai_docs_tracker.txt

          # Commit changes; exit gracefully if there's nothing new to commit
          git commit -m "docs: AI speed update [skip ci]" || exit 0

          # Crucial step: Pull latest changes from remote using rebase.
          # This puts the AI's documentation commits on top of your recent manual commits.
          # This prevents "rejected push" errors without needing --force.
          git pull --rebase origin ${{ github.ref_name }}

          # Push the integrated work back to the repository
          git push origin ${{ github.ref_name }}
